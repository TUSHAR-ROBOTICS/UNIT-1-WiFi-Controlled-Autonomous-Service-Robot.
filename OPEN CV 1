import cv2
import mediapipe as mp
from mediapipe.tasks import python
from mediapipe.tasks.python import vision
import serial
import time
import math
import os

# --- CONFIGURATION ---
PORT = "COM4"
BAUD_RATE = 115200
CAMERA_INDEX = 0
MODEL_PATH = "hand_landmarker.task"

# --- DOWNLOAD MODEL IF MISSING ---
if not os.path.exists(MODEL_PATH):
    print("Downloading hand_landmarker.task model file, please wait...")
    try:
        import urllib.request
        model_url = "https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task"
        urllib.request.urlretrieve(model_url, MODEL_PATH)
        print("Model downloaded successfully!")
    except Exception as e:
        print(f"Error downloading model: {e}")
        print("Please ensure you are connected to the internet.")

# --- SERIAL CONNECTION ---
print(f"Connecting to Arduino on {PORT}...")
try:
    ser = serial.Serial(PORT, BAUD_RATE, timeout=0.1)
    time.sleep(2)  # Wait for Arduino reset
    print(f"Successfully connected to Arduino on {PORT}!")
    mock_mode = False
except Exception as e:
    print(f"\n[WARNING] Could not connect to {PORT}: {e}")
    print("Running in MOCK/VISUAL ONLY mode. You can test hand gestures on-screen!")
    ser = None
    mock_mode = True

# --- MEDIAPIPE INITIALIZATION (Tasks API) ---
print("Initializing MediaPipe Hand Landmarker...")
try:
    base_options = python.BaseOptions(model_asset_path=MODEL_PATH)
    options = vision.HandLandmarkerOptions(
        base_options=base_options,
        running_mode=vision.RunningMode.IMAGE,
        num_hands=1
    )
    detector = vision.HandLandmarker.create_from_options(options)
    print("MediaPipe Hand Landmarker initialized successfully!")
except Exception as e:
    print(f"Error initializing MediaPipe Tasks: {e}")
    print("Make sure 'hand_landmarker.task' exists in the same directory.")
    exit(1)

# --- SKELETON CONNECTIONS FOR CUSTOM DRAWING ---
HAND_CONNECTIONS = [
    (0, 1), (1, 2), (2, 3), (3, 4),  # Thumb
    (0, 5), (5, 6), (6, 7), (7, 8),  # Index finger
    (9, 10), (10, 11), (11, 12),     # Middle finger
    (13, 14), (14, 15), (15, 16),    # Ring finger
    (0, 17), (17, 18), (18, 19), (19, 20), # Pinky
    (5, 9), (9, 13), (13, 17)        # Knuckles
]

def draw_landmarks(image, hand_landmarks):
    """Draw hand skeletal connections and landmarks on image using OpenCV."""
    h, w, c = image.shape
    # Draw connections with Solid Black
    for start_idx, end_idx in HAND_CONNECTIONS:
        p1 = hand_landmarks[start_idx]
        p2 = hand_landmarks[end_idx]
        pt1 = (int(p1.x * w), int(p1.y * h))
        pt2 = (int(p2.x * w), int(p2.y * h))
        cv2.line(image, pt1, pt2, (0, 0, 0), 2)
        
    # Draw landmark joints with Dark Charcoal Grey
    for landmark in hand_landmarks:
        pt = (int(landmark.x * w), int(landmark.y * h))
        cv2.circle(image, pt, 5, (50, 50, 50), -1)

def calculate_distance(p1, p2):
    """Calculate Euclidean distance between two 3D landmarks."""
    return math.sqrt((p1.x - p2.x)**2 + (p1.y - p2.y)**2 + (p1.z - p2.z)**2)

def map_value(value, from_low, from_high, to_low, to_high):
    """Map a value from one range to another, clamped to boundaries."""
    value = max(min(value, from_high), from_low)
    mapped = to_low + ((value - from_low) / (from_high - from_low)) * (to_high - to_low)
    return int(mapped)

# --- MAIN LOOP ---
cap = cv2.VideoCapture(CAMERA_INDEX)

# Define expected finger extension ratio ranges (Knuckle-to-Tip distance normalized by hand size)
INDEX_RANGE = (0.35, 0.85)
MIDDLE_RANGE = (0.35, 0.85)
RING_RANGE = (0.35, 0.85)

# Smooth angles using Simple Moving Average
angle_history = [[90]*5 for _ in range(3)]

print("\nStarting video stream. Press 'q' in the camera window to quit.")

while cap.isOpened():
    success, image = cap.read()
    if not success:
        print("Ignoring empty camera frame.")
        continue

    # Flip image horizontally for natural selfie view
    image = cv2.flip(image, 1)
    h, w, c = image.shape

    # Convert to RGB for MediaPipe Tasks
    image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
    mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=image_rgb)
    
    # Process image
    results = detector.detect(mp_image)

    # Convert display image to black & white (grayscale) and back to BGR for color drawings
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    image = cv2.cvtColor(gray, cv2.COLOR_GRAY2BGR)

    # Default angles
    servo1_angle = 90
    servo2_angle = 90
    servo3_angle = 90
    hand_detected = False

    if results.hand_landmarks:
        hand_detected = True
        for hand_landmarks in results.hand_landmarks:
            # Draw standard skeleton connections
            draw_landmarks(image, hand_landmarks)

            # Extract key landmarks
            wrist = hand_landmarks[0]
            index_mcp = hand_landmarks[5]
            middle_mcp = hand_landmarks[9]
            ring_mcp = hand_landmarks[13]
            
            index_tip = hand_landmarks[8]
            middle_tip = hand_landmarks[12]
            ring_tip = hand_landmarks[16]

            # Compute reference distance (wrist to middle knuckle) to handle camera zoom
            ref_dist = calculate_distance(wrist, middle_mcp)
            
            if ref_dist > 0.001:
                # Calculate knuckle-to-tip distance for Index, Middle, and Ring fingers
                d_index = calculate_distance(index_mcp, index_tip)
                d_middle = calculate_distance(middle_mcp, middle_tip)
                d_ring = calculate_distance(ring_mcp, ring_tip)

                # Calculate extension ratios (immune to wrist movement)
                r_index = d_index / ref_dist
                r_middle = d_middle / ref_dist
                r_ring = d_ring / ref_dist

                # Map ratios to 0-180 degree servo angles
                raw_s1 = map_value(r_index, INDEX_RANGE[0], INDEX_RANGE[1], 0, 180)
                raw_s2 = map_value(r_middle, MIDDLE_RANGE[0], MIDDLE_RANGE[1], 0, 180)
                raw_s3 = map_value(r_ring, RING_RANGE[0], RING_RANGE[1], 0, 180)

                # Update history and smooth values
                angle_history[0].pop(0)
                angle_history[0].append(raw_s1)
                servo1_angle = int(sum(angle_history[0]) / len(angle_history[0]))

                angle_history[1].pop(0)
                angle_history[1].append(raw_s2)
                servo2_angle = int(sum(angle_history[1]) / len(angle_history[1]))

                angle_history[2].pop(0)
                angle_history[2].append(raw_s3)
                servo3_angle = int(sum(angle_history[2]) / len(angle_history[2]))

    # --- TRANSMIT SERIAL DATA ---
    if not mock_mode and ser and ser.is_open:
        try:
            # Send individual commands for each servo
            ser.write(f"s1:{servo1_angle}\n".encode('utf-8'))
            ser.write(f"s2:{servo2_angle}\n".encode('utf-8'))
            ser.write(f"s3:{servo3_angle}\n".encode('utf-8'))
            
            if ser.in_waiting > 0:
                resp = ser.readline().decode('utf-8', errors='ignore').strip()
                print(f"[Arduino]: {resp}")
        except Exception as e:
            print(f"Serial transmission error: {e}")
            mock_mode = True

    # --- UI DRAWING (HUD) ---
    # Draw a solid, dark, near-black panel background (fully opaque)
    cv2.rectangle(image, (10, 10), (330, 210), (15, 15, 15), -1)
    # Draw a sleek, dark charcoal border around the HUD panel
    cv2.rectangle(image, (10, 10), (330, 210), (50, 50, 50), 2)

    # Status text (using a sleek light grey for minimalist theme)
    status_str = f"STATUS: Connected ({PORT})" if not mock_mode else "STATUS: MOCK MODE (NO ARDUINO)"
    status_color = (180, 180, 180)
    cv2.putText(image, status_str, (20, 35), cv2.FONT_HERSHEY_SIMPLEX, 0.6, status_color, 2)
    
    cv2.putText(image, f"Hand Tracked: {'YES' if hand_detected else 'NO'}", (20, 65), 
                cv2.FONT_HERSHEY_SIMPLEX, 0.5, (180, 180, 180), 1)

    # Draw Servo Gauges
    gauge_y = [100, 140, 180]
    labels = ["Servo 1 (Index)", "Servo 2 (Middle)", "Servo 3 (Ring)"]
    angles = [servo1_angle, servo2_angle, servo3_angle]
    # Colors matching the dark minimalist theme (sleek dark grey fills)
    colors = [(70, 70, 70), (90, 90, 90), (110, 110, 110)]

    for i in range(3):
        cv2.putText(image, f"{labels[i]}: {angles[i]} deg", (20, gauge_y[i] - 10), 
                    cv2.FONT_HERSHEY_SIMPLEX, 0.45, (180, 180, 180), 1)
        # Background bar for gauge (deep dark black/grey)
        cv2.rectangle(image, (20, gauge_y[i]), (220, gauge_y[i] + 12), (30, 30, 30), -1)
        fill_width = int((angles[i] / 180.0) * 200)
        cv2.rectangle(image, (20, gauge_y[i]), (20 + fill_width, gauge_y[i] + 12), colors[i], -1)

    cv2.putText(image, "Press 'q' to Quit", (20, h - 20), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)
    cv2.imshow("Hand Control - 3 Servos", image)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
if ser:
    ser.close()
print("Session closed successfully.")
